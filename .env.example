# Copy to .env (or set keys from the UI: Settings). Set either key, or both.

# Claude: writes titles / descriptions / tags (default model: claude-haiku-5-5)
ANTHROPIC_API_KEY=

# Groq: Whisper transcripts + (if no Anthropic key) titles / descriptions / tags
GROQ_API_KEY=

# Which LLM writes metadata: auto (whichever key is set; Claude if both) | anthropic | groq
# LLM_PROVIDER=auto

# Optional overrides
# ANTHROPIC_MODEL=claude-haiku-5-5
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# OUTPUT_DIR=projects
# FFMPEG_PATH=C:\path\to\ffmpeg.exe
